  "motherhome1", "fatherhome1", "stepmohome1", "stepfahome1",          #Family structure could be used for balance tests?
  "feellow", "irritable", "nervous", "sleepdifficulty", "lifesat",     #Main OUTCOME variables --> Will build index from
  "beenbullied", "studaccept", "talkmother", "talkfather"              #Other potential outcomes of treatments
)

# 2014 uses different names for some variables: new name = "2014 name"
rename_2014 <- c(classno = "classid", schoolno = "id2",
                 sleepdifficulty = "sleepdificulty",
                 famcar = "fasfamcar", bedroom = "fasbedroom",
                 holidays = "fasholidays", computers = "fascomputers")

