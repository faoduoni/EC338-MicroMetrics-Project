############Narrowing DataSet to include the variables we want######### 

keep <- c(
  # design / identifiers
  "countryno", "schoolno", "classno",                                  #Key Identifiers for each variable
  "sex", "age", "agecat",                                              #Controls Needed
  "famcar", "bedroom", "holidays", "computers",                        #Will be a Family Affluence Scale from this
  "occupsesfa", "occupsesmo",                                          #Parental occupation
