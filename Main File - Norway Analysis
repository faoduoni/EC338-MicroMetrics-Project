household_2014 <- c("motherhome1", "fatherhome1", "stepmohome1", "stepfahome1",
                    "grandmohome1", "grandfahome1", "fosterhome1", "elsehome1")



#######Reading each wave, 2014 dataset formatted differently #######
read_wave <- function(path, vars) {
  pattern <- paste0("^(", paste(vars, collapse = "|"), ")$")   # match names, any case
  first_line <- readLines(path, n = 1)
  if (grepl(";", first_line)) {
    read_delim(path, delim = ";",
               locale = locale(decimal_mark = ","),
               na = c("", " ", "."), trim_ws = TRUE,
               col_select = matches(pattern, ignore.case = TRUE),
               guess_max = Inf, show_col_types = FALSE)
  } else {
    read_csv(path, na = c("", " ", "."),
             col_select = matches(pattern, ignore.case = TRUE),
             guess_max = Inf, show_col_types = FALSE)
  }
}

vars_2014 <- unique(c(setdiff(keep, names(rename_2014)), rename_2014, household_2014))

waves <- imap(files, ~ read_wave(.x, if (.y == "2014") vars_2014 else keep)) |>
  map(~ rename_with(.x, tolower))           # COUNTRYno -> countryno, AGECAT -> agecat


#Reduce dataset to Norway Only
wavesNorway <- map(waves, ~ filter(.x, countryno == 578000))
rm(waves)

#Recode 2014 TickBoxes
# household tick boxes (1 = ticked, blank = not ticked) -> 1 = yes, 2 = no;
# if no box at all was ticked, treat the question as unanswered (NA)
wavesNorway[["2014"]] <- wavesNorway[["2014"]] |>
  rename(all_of(rename_2014)) |>
  mutate(answered_household = if_any(all_of(household_2014), ~ !is.na(.x)),
         across(all_of(household_2014),
                ~ case_when(.x == 1 ~ 1,
                            answered_household ~ 2,
                            TRUE ~ NA_real_)))

# keep the same variables, in the same order, as numbers, in every wave
missing_vars <- map(wavesNorway, ~ setdiff(keep, names(.x)))
if (any(lengths(missing_vars) > 0)) {
  print(missing_vars[lengths(missing_vars) > 0])
  stop("Some variables in 'keep' are missing from a wave (listed above).")
}

wavesNorway <- map(wavesNorway, ~ .x |>
                     select(all_of(keep)) |>
                     mutate(across(everything(), as.numeric)))


#Stack Waves:
FinalNorwayDataset <- bind_rows(wavesNorway, .id = "wave") |>
  mutate(
    wave = as.integer(wave),
    # IDs are only unique within a wave, and in 2010 class numbers repeat
    # across schools, so must build IDs from school_ID, Class_ID and Wave
    school_id = paste(wave, schoolno, sep = "_"),
    class_id  = paste(wave, schoolno, classno, sep = "_"),
    #sibling counts: negative or non-whole values are errors
    # (the 2014 international file has a few -1 and 0.5; none in Norway)
    across(c(brothershome1, sistershome1),
           ~ ifelse(.x < 0 | .x != round(.x), NA, .x))
  )

