######Building Analysis Variables###############

#The Mental Health Outcome Variable 
#Index of key mental health indicators (MHI)
mhi <- c("feellow", "irritable", "nervous", "sleepdifficulty")
#Will reverse the items (Higher number = More symptoms)

FinalNorwayDataset <- FinalNorwayDataset |>
  mutate(across(all_of(mhi), ~ 6 - .x, .names = "{.col}_r"))

#Will Include Index weights -> Can pick and justify later
mhiWeights <- c(feellow = 1, irritable = 1, nervous = 1, sleepdifficulty = 1)

#Produce Weighted average of the reversed items
mhi_r <- paste0(mhi, "_r")
w <- mhiWeights[mhi] / sum(mhiWeights)
FinalNorwayDataset$mhi <- as.vector(as.matrix(FinalNorwayDataset[mhi_r]) %*% w)
View(FinalNorwayDataset)




########Build Treatment Variables#######

#Own Sex Variable: Needed for interaction term
FinalNorwayDataset <- FinalNorwayDataset |> mutate(girl = as.integer(sex == 2)) #If boy = 0, if girl = 1s

# Sibling gender
FinalNorwayDataset <- FinalNorwayDataset |>
  mutate(
    nbrothers = brothershome1,                        # treatment: number of brothers
    #Given we will control for family size, this variable asks: Given family size is the same size, what is the effect of one of those siblings 
    #being a brother. 
    nsibs     = brothershome1 + sistershome1,         # family size
    nsibs_cat = factor(ifelse(nsibs >= 4, "4+", nsibs),
                       levels = c("0", "1", "2", "3", "4+"))   # family-size dummies
  )


# Class composition --> Uses Class Id, to find sex of all children in same class
FinalNorwayDataset <- FinalNorwayDataset |>
  group_by(class_id) |>
  mutate(
    class_n         = n(),                                     # respondents in the class
    share_girls_loo = (sum(girl) - girl) / (class_n - 1)       # leave-one-out share of girls
  ) |>
  ungroup() |>
  mutate(share_girls_100 = share_girls_loo * 100)                # Rescales share of girls: unit change = +1pp increase in girls


View(FinalNorwayDataset)

#####Control Variables######
#Parent Occupation is categorical --> Need to adjust so enters regression as dummy variables
# 1-5 = SES 1 (high) to 5 (low); 6 = job, not classified; 7 = not in work;
#           8 = looking for job; 9 = home working; 10 = don't know;
#           11 = don't have or see this parent; 12 = not classifiable
group_occ <- function(x) {
  factor(case_when(x %in% 1:5      ~ paste0("SES", x),
                   x %in% c(6, 12) ~ "job, not classified",
                   x %in% 7:9      ~ "not in paid work",
                   x == 10         ~ "don't know",
                   x == 11         ~ "no parent"),
         levels = c("SES1", "SES2", "SES3", "SES4", "SES5", "job, not classified",
                    "not in paid work", "don't know", "no parent"))
}

FinalNorwayDataset <- FinalNorwayDataset |>
  mutate(occ_fa = group_occ(occupsesfa),
         occ_mo = group_occ(occupsesmo))


View(FinalNorwayDataset)



#########Assessing if Treatments are as good as random#########


library(fixest)

#Restrict the sample to classes with more than 10 students
analysis <- FinalNorwayDataset |>
  filter(class_n >= 10, !is.na(agecat))

#Restrict to those who have a sibling
sibSample <- analysis |> filter(nsibs > 0)

#Sibling Genders
# Is the share of brothers close to 51.2% (the sex ratio at birth)?
shareBrothers <- sibSample |>
  group_by(agecat) |>
  summarise(siblings       = sum(nsibs),
            brothers       = sum(nbrothers),
            share_brothers = brothers / siblings,
            pValue         = binom.test(brothers, siblings, p = 0.512)$p.value)


# Partial correlations: number of brothers vs each characteristic,
# Holding family size and wave fixed, by age group
balance_vars <- c("girl", "age", "famcar", "holidays", "computers")

cor_table <- sapply(1:3, function(g) {
  d <- filter(sibSample, agecat == g)
  # part of nbrothers not explained by family size and wave
  d$brothers_resid <- resid(lm(nbrothers ~ nsibs_cat + factor(wave), data = d, na.action = na.exclude))
  sapply(balance_vars, function(v) cor(d$brothers_resid, d[[v]], use = "complete.obs"))
})
colnames(cor_table) <- c("Age 11", "Age 13", "Age 15")
round(cor_table, 3)


#Class Composition
#Shuffle children around classes and observe the differences in the spread

spreadCheck <- function(data, reps = 500) {
  # real spread: SD of the share of girls across classes
  realSD <- data |> group_by(class_id) |> summarise(share = mean(girl)) |> pull(share) |> sd()
  # random spread: shuffle sex across classes (within wave), same class sizes
  simSD <- replicate(reps, {
    data |>
      group_by(wave) |> mutate(girl_sim = sample(girl)) |>
      group_by(class_id) |> summarise(share = mean(girl_sim)) |> pull(share) |> sd()
  })
  c(realSD = realSD, randomSD = mean(simSD), p_value = mean(simSD >= realSD))
}

spread <- sapply(1:3, function(g) spreadCheck(filter(analysis, agecat == g)))
colnames(spread) <- c("Age 11", "Age 13", "Age 15")
round(spread, 3)

#RESULT --> age group 15 has class compositions that we cannot trust to be random

#########MAIN OLS TEST###########

#Main sample: ages 11 and 13 only (class composition not random at age 15)
mainSample <- analysis |> filter(agecat %in% c(1, 2))

mainSample |> group_by(girl) |> summarise(mean_mhi = mean(mhi, na.rm = TRUE), sd_mhi = sd(mhi, na.rm = TRUE), n = sum(!is.na(mhi)))

#Mental health index (1-5, higher = more symptoms)
m_mhi <- feols(mhi ~ nbrothers:factor(girl) + share_girls_100:factor(girl) + girl +
                 age + famcar + holidays + computers + occ_fa + occ_mo |
                 nsibs_cat + wave + agecat,
               data = mainSample, cluster = ~class_id)
#NOTE: The difference in reporting. The equation reports a baseline + difference:
        #β₁ = effect of a brother for boys
        #β₂ = how much the effect differs for girls, so girls’ effect = β₁ + β₂
        #Code reports each group’s effect directly:
        #nbrothers:factor(girl)0 = effect for boys = β₁
        #nbrothers:factor(girl)1 = effect for girls = β₁ + β₂


etable(m_mhi,keep = c("nbrothers", "share_girls", "girl"), digits = 4)


